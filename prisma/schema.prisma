// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  fullName   String   @map("full_name")
  email      String
  phone      String
  password   String
  profilePic String?  @map("profile_pic")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  media     Media[]
  playlists Playlist[]
  devices   Device[]

  @@map("users")
}

model Playlist {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  medias  PlaylistMedia[]
  devices Device[]

  @@map("playlists")
}

model Media {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  path      String
  mimeType  String   @map("mime_type")
  size      BigInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlists PlaylistMedia[]

  @@map("media")
}

model PlaylistMedia {
  playlistId String @map("playlist_id") @db.Uuid
  mediaId    String @map("media_id") @db.Uuid
  position   Int
  // default just cuz i already got records
  duration   Int    @default(15)

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media    Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([playlistId, mediaId])
  @@map("playlist_media")
}

model Device {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  name            String
  description     String?
  playlistId      String?   @map("playlist_id") @db.Uuid
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  activationToken String?   @map("activation_token")
  tokenExpiresAt  DateTime? @map("token_expires_at") @db.Timestamp(6)
  deviceToken     String?   @map("device_token")

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlist Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  @@map("devices")
}
